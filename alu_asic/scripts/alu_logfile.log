Design area 359 um^2 100% utilization.
# -------------------------
# Automatic Core Sizing
# -------------------------
# design_area returned in m^2
set design_area_m2 [rsz::design_area]
# convert to µm^2
set design_area_um2 [expr $design_area_m2 * 1e12]
set core_area_value [expr $design_area_um2 / $utilization]
set core_side [expr sqrt($core_area_value)]
set margin 10
#set core_area [list \
#  $margin \
#  $margin \
#  [expr $core_side + $margin] \
#  [expr $core_side + $margin] ]
#set die_area [list \
#  0 0 \
#  [expr $core_side + 2*$margin] \
#  [expr $core_side + 2*$margin] ]
set die_area {0 0 200 200}
set core_area {20 20 180 180}
puts "Design area (um^2): $design_area_um2"
Design area (um^2): 358.8339902993454
puts "Core side (um): $core_side"
Core side (um): 24.455196799431178
set_thread_count [cpu_count]
